@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ddvisitor CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
if(@HG_BUNDLE_FMT@)
    find_dependency(fmt CONFIG REQUIRED PATHS "${CMAKE_CURRENT_LIST_DIR}/../fmt" NO_DEFAULT_PATH)
else()
    find_dependency(fmt CONFIG REQUIRED)
endif()
set(hg_python_FOUND FALSE)
if("python" IN_LIST hg_FIND_COMPONENTS AND @HG_BUILD_PYTHON@)
    find_dependency(Python 3.12 COMPONENTS Interpreter Development.Module Development.SABIModule)
    execute_process(
        COMMAND "${Python_EXECUTABLE}" -m nanobind --cmake_dir
        OUTPUT_VARIABLE nanobind_cmake_dir
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE nanobind_cmake_dir_result
    )
    if(NOT nanobind_cmake_dir_result EQUAL 0)
        message(FATAL_ERROR "The hg::python target requires nanobind in the selected Python environment")
    endif()
    list(PREPEND CMAKE_PREFIX_PATH "${nanobind_cmake_dir}")
    find_dependency(nanobind CONFIG)
    execute_process(
        COMMAND "${Python_EXECUTABLE}" -m nanobind --include_dir
        OUTPUT_VARIABLE nanobind_include_dir
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE nanobind_include_dir_result
    )
    if(NOT nanobind_include_dir_result EQUAL 0)
        message(FATAL_ERROR "The hg::python target requires nanobind in the selected Python environment")
    endif()
    set(hg_python_FOUND TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hgTargets.cmake")

if(hg_python_FOUND)
    set_property(TARGET hg::python APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${nanobind_include_dir}")
    set_property(TARGET hg::python APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS "Py_LIMITED_API=0x030C0000")
endif()

check_required_components(hg)
